# Copy to .env.staging and fill in real values. Used by docker-compose.staging.yml.

# --- App ---
JWT_SECRET=change-me
SPEAKER_ID_SALT=change-me
CLIENT_URL=https://staging.example.org
LOG_LEVEL=info

# --- Database (points at the compose 'postgres' service) ---
DATABASE_URL=postgresql://crowdsourcer:change-me@postgres:5432/crowd_source_voice_db
POSTGRES_PASSWORD=change-me

# --- Storage (S3 or an S3-compatible store, e.g. MinIO) ---
STORAGE_DRIVER=s3
S3_BUCKET=crowd-source-voice-staging
S3_REGION=us-east-1
# Only needed for MinIO/non-AWS S3-compatible endpoints; leave unset for AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Compose-only knobs (used to interpolate docker-compose.staging.yml —
# pass this file with `docker compose --env-file .env.staging ...`) ---
APP_PORT=3001
IMAGE_TAG=sha-xxxxxxx
