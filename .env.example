# Server Configuration
PORT=3001
NODE_ENV=development

# Database
# This default matches the docker-compose.yml Postgres service (host port 7005).
# Adjust if you run your own PostgreSQL instance.
DATABASE_URL=postgresql://crowdsourcer:crowdsourcer_password@localhost:7005/crowd_source_voice_db

# JWT Secret (generate a secure random string for production)
JWT_SECRET=your-secret-key-change-in-production

# Salt used to derive anonymized per-contributor speaker_id values in the
# admin export API (server/utils/speakerId.js). Generate a secure random
# string for production — without it, speaker_id is still one-way but
# guessable via dictionary attacks against known email addresses, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do NOT change it after data has been exported: speaker ids derive from it,
# so changing it gives every speaker a new id.
SPEAKER_ID_SALT=change-this-salt-in-production

# Optional long-lived READ-ONLY token for unattended dataset sync
# (Authorization: Bearer <token>). Accepted only on GET /api/export,
# /api/export/manifest, /api/export/stats and /api/export/audio/:recordingId;
# grants nothing else. Validated recordings only (>= 2 validations and
# quality_score >= 4.0): include_all=true is refused (403) with this token and
# needs an admin JWT. Use a long random value (same command as above).
# Empty/unset = feature off (only admin JWTs work). Rotate by changing the
# value and restarting the server.
EXPORT_API_TOKEN=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Log verbosity for pino (trace|debug|info|warn|error|fatal). Logs never
# include PII — only IDs, UUID storage keys, and request method/route/status.
LOG_LEVEL=info

# File storage driver: 'local' (default, writes to uploads/) or 's3'.
STORAGE_DRIVER=local

# --- S3 config (only read when STORAGE_DRIVER=s3) ---
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# Only set S3_ENDPOINT/S3_FORCE_PATH_STYLE for MinIO or another
# S3-compatible store; leave both unset for real AWS S3.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Leave both unset to fall back to the default AWS credential chain
# (e.g. an IAM role) instead of static keys.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
