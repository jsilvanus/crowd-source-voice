# Copy to .env.prod and fill in real values. Used by docker-compose.prod.yml.

# --- App ---
JWT_SECRET=change-me
SPEAKER_ID_SALT=change-me
CLIENT_URL=https://voice.example.org
LOG_LEVEL=info

# --- Database (external managed Postgres, not run by this compose file) ---
DATABASE_URL=postgresql://user:password@external-postgres-host:5432/crowd_source_voice_db

# --- Storage (S3 or an S3-compatible store) ---
STORAGE_DRIVER=s3
S3_BUCKET=crowd-source-voice-prod
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Leave both unset to use the host's IAM role instead of static credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Compose-only knobs (used to interpolate docker-compose.prod.yml —
# pass this file with `docker compose --env-file .env.prod ...`) ---
APP_DOMAIN=voice.example.org
TRAEFIK_CERTRESOLVER=letsencrypt
IMAGE_TAG=1.2.3
